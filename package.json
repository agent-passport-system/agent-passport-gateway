{
  "name": "agent-passport-gateway",
  "version": "0.4.1",
  "description": "AEOESS Hosted Enforcement Gateway",
  "main": "dist/server.js",
  "scripts": {
    "build": "npx tsc && npm run copy-assets",
    "copy-assets": "mkdir -p dist/gateway/regulated-action && cp src/gateway/regulated-action/*.mjs dist/gateway/regulated-action/",
    "start": "node dist/server.js",
    "dev": "npx tsx src/server.ts",
    "test": "npx tsx --test test/*.test.ts test/**/*.test.ts tests/sdk-migrated/*.test.ts tests/sdk-migrated/**/*.test.ts"
  },
  "keywords": [],
  "author": "Tymofii Pidlisnyi",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "agent-passport-system": "^3.3.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "csv-stringify": "^6.7.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nanocurrency-web": "^1.4.3",
    "pdfkit": "^0.18.0",
    "rate-limiter-flexible": "^10.0.1",
    "stripe": "^20.4.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/pdfkit": "^0.17.5",
    "@types/uuid": "^10.0.0",
    "jose": "^6.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
